{
  "name": "obsidian-wasm-image",
  "version": "0.6.0",
  "description": "Fast image to WebP conversion using WebAssembly for Obsidian",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "webp",
    "image",
    "conversion",
    "webassembly",
    "wasm"
  ],
  "author": "KawaNae",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KawaNae/Obsidian-wasm-image-converter.git"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.20.5",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.23.0",
    "obsidian": "latest",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/webp": "1.4.0",
    "wasm-feature-detect": "^1.9.0"
  }
}
